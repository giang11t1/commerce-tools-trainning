{
  "name": "my-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
      "dev": "concurrently -k -n next,email,studio \"npm:dev:next\" \"npm:dev:email\" \"npm:dev:studio\"",
      "dev:next": "next dev",
      "dev:email": "NODE_OPTIONS='--require ./scripts/register-server-only.cjs' tsx watch scripts/watch-email-jobs.ts",
      "dev:studio": "prisma studio --port 5555",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:cart-pricing": "node --experimental-strip-types --test src/lib/cart-line-item.test.mjs",
    "test:subscription-offers": "node --experimental-strip-types --test src/lib/subscription-offers.test.mjs",
    "email:worker": "NODE_OPTIONS='--require ./scripts/register-server-only.cjs' tsx scripts/process-email-jobs.ts",
    "email:watch": "NODE_OPTIONS='--require ./scripts/register-server-only.cjs' tsx scripts/watch-email-jobs.ts",
      "newsletter:test": "NODE_OPTIONS='--require ./scripts/register-server-only.cjs' tsx scripts/test-newsletter-marketing.ts"
  },
  "dependencies": {
    "@adyen/adyen-web": "^6.44.0",
    "@commercetools-frontend/application-shell-connectors": "^27.11.0",
    "@commercetools-frontend/ui-kit": "^20.6.7",
    "@commercetools/checkout-browser-sdk": "^1.7.4",
    "@commercetools/frontend-sdk": "^2.1.1",
    "@commercetools/platform-sdk": "^9.2.0",
    "@commercetools/sdk-client-v2": "^4.0.0",
    "@commercetools/ts-client": "^5.0.3",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@next/env": "^16.4.6",
    "@next/third-parties": "^16.4.6",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^6.19.3",
    "@sendgrid/mail": "^8.1.6",
    "@splidejs/react-splide": "^0.7.12",
    "@splidejs/splide": "^4.1.4",
    "dompurify": "^3.4.15",
    "dotenv": "^18.0.0",
    "flag-icons": "^7.5.0",
    "formik": "^2.4.9",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.31.0",
    "markdown": "^0.5.0",
    "next": "16.3.0",
    "next-cloudinary": "^6.18.8",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-instantsearch": "^7.49.0",
    "react-intersection-observer": "^11.0.1",
    "react-loading-skeleton": "^3.5.0",
    "react-modal": "^3.16.3",
    "server-only": "^0.0.1",
    "swiper": "^14.2.0",
    "swr": "^2.5.1",
    "use-intl": "^4.13.7"
  },
  "devDependencies": {
    "@storybook/react": "^10.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-modal": "^3.16.3",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
